<!-- Plugin Configuration File: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN, cannot be changed between the plugin versions. -->
    <id>com.songwh.bos-project-init</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>BOS Project Initialization Assistant</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://songwh.top">songwh</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
        <p>
            <strong>BOS Project Initialization Assistant</strong> helps you quickly initialize and configure BOS projects from Git repositories.
        </p>
        <p>
            <strong>Key Features:</strong>
        </p>
        <ul>
            <li>Clone multiple Git repositories with one click</li>
            <li>Automatically generate settings.gradle configuration</li>
            <li>Automatically generate build_local.gradle files</li>
            <li>Support sub-module build_local.gradle generation</li>
            <li>Sync config.gradle files across projects</li>
            <li>Security validation for Git URLs and paths</li>
            <li>Bilingual support (Chinese/English)</li>
        </ul>
        <p>
            <strong>How to Use:</strong>
        </p>
        <ol>
            <li>Go to <strong>Tools → BOS Project Initialization Assistant</strong></li>
            <li>Configure project root path</li>
            <li>Add Git repository URLs (one per line)</li>
            <li>Click <strong>Initialize</strong> to start</li>
        </ol>
        <p>
            <em>Version: 1.1.2 | Author: songwh</em>
        </p>
    ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.compose</depends>

    <depends>com.intellij.modules.json</depends>
    <depends>Git4Idea</depends>
    <resource-bundle>messages.MessageBundle</resource-bundle>

    <actions>
        <action id="com.songwh.bosprojectinit.actions.ProjectInitAction"
                class="com.songwh.bosprojectinit.actions.ProjectInitAction">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>

    <!-- Extensions defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <!-- 注册应用级别的服务 -->
        <applicationService serviceImplementation="com.songwh.bosprojectinit.settings.PluginSettings"/>
        
        <!-- 注册设置页面 -->
        <applicationConfigurable
                parentId="tools"
                instance="com.songwh.bosprojectinit.settings.PluginSettingsConfigurable"
                id="com.songwh.bosprojectinit.settings.PluginSettingsConfigurable"
                displayName="BOS Project Initialization"/>
    </extensions>
    <!--<extensions defaultExtensionNs="com.intellij">
        <toolWindow id="BosProjectInitTool" factoryClass="com.songwh.bosprojectinit.BosProjectInitToolFactory"
                    icon="AllIcons.Toolwindows.ToolWindowPalette"/>
    </extensions>-->
</idea-plugin>
